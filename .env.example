# Message Central VerifyNow Credentials
# From your Message Central Dashboard -> "Your Credentials"
MESSAGE_CENTRAL_CUSTOMER_ID="C-xxxxxxxxxxxxxx95"
MESSAGE_CENTRAL_AUTH_TOKEN="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." # The "Auth Token" from your dashboard
# Alternatively: MESSAGE_CENTRAL_API_KEY="eyJhbG..." or your password
MESSAGE_CENTRAL_EMAIL="your_registered_email_here"
MESSAGE_CENTRAL_ENV="sandbox" # Set to "sandbox" for testing credits or "live" for production

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_READ_TOKEN="your_read_token"
SANITY_API_WRITE_TOKEN="your_write_token"
SANITY_PREVIEW_SECRET="your_preview_secret"

# Database Connections (PostgreSQL / Supabase)
DATABASE_URL="postgresql://username:password@host:6543/postgres"
DIRECT_URL="postgresql://username:password@host:5432/postgres"

# Razorpay Credentials
